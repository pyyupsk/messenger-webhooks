# Facebook Messenger Bot Configuration

# Your Facebook Page Access Token
# Get it from: https://developers.facebook.com/apps/ > Your App > Messenger > Settings > Access Tokens
ACCESS_TOKEN=your_facebook_page_access_token_here

# Your Webhook Verify Token (can be any string you choose)
# This token is used to verify webhook requests from Facebook
# Make sure to use the same token when setting up your webhook in Facebook Developer Console
VERIFY_TOKEN=your_custom_verify_token_here

# Optional: Port number for the webhook server (default: 8080)
# PORT=8080

# Optional: Webhook endpoint path (default: /webhook)
# ENDPOINT=/webhook