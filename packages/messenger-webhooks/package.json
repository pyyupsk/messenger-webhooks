{
  "name": "@pyyupsk/messenger-webhooks",
  "version": "1.3.0",
  "type": "module",
  "description": "A simple and easy-to-use library for building Facebook Messenger bots with webhooks.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyyupsk/messenger-webhooks.git"
  },
  "homepage": "https://messenger-webhooks.vercel.app/",
  "bugs": "https://github.com/pyyupsk/messenger-webhooks/issues",
  "author": "pyyupsk <pyyupsk@proton.me>",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.mts",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "keywords": [
    "messenger",
    "webhooks",
    "facebook",
    "bot",
    "library"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/express": "^5.0.2",
    "tsdown": "^0.16.6",
    "typescript": "^5.8.3"
  }
}
