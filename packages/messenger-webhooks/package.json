{
    "name": "@pyyupsk/messenger-webhooks",
    "version": "1.3.0",
    "type": "module",
    "description": "A simple and easy-to-use library for building Facebook Messenger bots with webhooks.",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pyyupsk/messenger-webhooks.git"
    },
    "homepage": "https://messenger-webhooks.vercel.app/",
    "bugs": "https://github.com/pyyupsk/messenger-webhooks/issues",
    "author": "pyyupsk <pyyupsk@proton.me>",
    "license": "MIT",
    "main": "./dist/index.cjs",
    "types": "dist/index.d.ts",
    "module": "./dist/index.js",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "keywords": [
        "messenger",
        "webhooks",
        "facebook",
        "bot",
        "library"
    ],
    "scripts": {
        "build": "tsup",
        "lint": "eslint src"
    },
    "dependencies": {
        "express": "^5.1.0"
    },
    "devDependencies": {
        "@repo/eslint-config": "workspace:*",
        "@repo/typescript-config": "workspace:*",
        "@types/express": "^5.0.2",
        "tsup": "^8.5.0",
        "typescript": "^5.8.3"
    }
}
