{
  "name": "@repo/root",
  "version": "1.3.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "format": "biome format --write",
    "lint": "biome check",
    "lint:fix": "biome check --fix",
    "prepare": "husky",
    "release": "bun changeset publish --filter=@pyyupsk/messenger-webhooks",
    "start": "turbo start",
    "test": "bun test --filter=@repo/tests"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.7",
    "@changesets/cli": "^2.29.7",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@types/node": "^24.10.1",
    "husky": "^9.1.7",
    "knip": "^5.70.1",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2",
    "prettier-plugin-pkg": "^0.21.2",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3"
  }
}
