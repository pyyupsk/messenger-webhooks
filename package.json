{
  "name": "@repo/root",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "format": "biome format --write",
    "lint": "biome check && eslint",
    "lint:fix": "biome check --fix && eslint --fix",
    "lint:jsdoc": "eslint",
    "release": "bun changeset publish --filter=@pyyupsk/messenger-webhooks",
    "start": "turbo start",
    "test": "bun test --filter=@repo/tests",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "eslint-plugin-jsdoc": "^61.4.1",
    "knip": "^5.71.0",
    "lefthook": "^2.0.4",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  }
}
